{
  "name": "@captures/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
