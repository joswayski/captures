{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CES",
  "version": "0.1.0",
  "identifier": "io.github.joswayski.ces",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' ces-capture: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A lightweight, private screenshot utility",
    "longDescription": "Capture regions, windows, and displays without uploading your screenshots.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
