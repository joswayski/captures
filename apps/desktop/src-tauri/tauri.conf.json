{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Captures",
  "version": "0.1.0",
  "identifier": "io.github.joswayski.captures",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' captures-capture: http://captures-capture.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "A lightweight, private screenshot utility",
    "longDescription": "Capture regions, windows, and displays without uploading your screenshots.",
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNjI5NTdGQTcwNjZDMkYKUldRdmJBYW5mNVZpUUVDR2NUWStpaWxOMDBWNjhBc1FxWmRXM2pyVGZvRFoxaVdPODZCWWdFYlUK",
      "endpoints": [
        "https://github.com/joswayski/captures/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
