{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Captures UI probe",
  "version": "0.1.0",
  "identifier": "io.github.joswayski.captures.ui-probe",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Captures UI probe", "width": 800, "height": 600, "resizable": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost" }
  },
  "bundle": { "active": false, "icon": ["../../apps/desktop/src-tauri/icons/32x32.png"] }
}
