{
  "name": "captures",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/api-worker",
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run tauri:dev --workspace @captures/desktop",
    "dev:api": "npm run dev --workspace @captures/api-worker",
    "dev:web": "npm run dev --workspace @captures/web",
    "build": "node scripts/build.mjs",
    "build:api": "npm run build --workspace @captures/api-worker",
    "prepare:media": "bash scripts/build-ffmpeg-sidecars.sh",
    "install:preview": "node scripts/install-latest-release.mjs",
    "build:web": "npm run build --workspace @captures/web",
    "deploy:api": "npm run deploy --workspace @captures/api-worker --",
    "deploy:web": "npm run deploy --workspace @captures/web --",
    "start:web": "npm run start --workspace @captures/web",
    "check": "npm run test:release-version && npm run check --workspace @captures/desktop && npm run build:web && npm run build:api",
    "test:release-version": "node --test scripts/*.test.mjs",
    "test": "npm run test --workspace @captures/desktop"
  },
  "engines": {
    "node": ">=24"
  }
}
