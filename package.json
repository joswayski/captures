{
  "name": "captures",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/desktop",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run tauri:dev --workspace @captures/desktop",
    "dev:web": "npm run dev --workspace @captures/web",
    "build": "node scripts/build.mjs",
    "build:signed": "node scripts/build-signed-local.mjs",
    "prepare:media": "bash scripts/build-ffmpeg-sidecars.sh",
    "install:preview": "node scripts/install-latest-release.mjs",
    "build:web": "npm run build --workspace @captures/web",
    "start:web": "npm run start --workspace @captures/web",
    "check": "npm run lint && npm run fmt:check && npm run test:release-version && npm run check --workspace @captures/desktop && npm test --workspace @captures/web && npm run build:web",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx,css}\" \"**/package.json\" \"**/tsconfig*.json\" \".ox*.json\"",
    "fmt:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx,css}\" \"**/package.json\" \"**/tsconfig*.json\" \".ox*.json\"",
    "test:release-version": "vitest run --project scripts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "vitest": "5.0.3"
  }
}
