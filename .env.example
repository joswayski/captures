# Copy to .env; Docker Compose loads it automatically. No production credentials.
# Set these to your host user's `id -u` and `id -g` for the AWS SSO mount.
LOCAL_UID=1000
LOCAL_GID=1000

AWS_PROFILE=your-sso-profile
AWS_REGION=your-ses-region
SES_FROM_ADDRESS=your-verified-sender
SES_CONFIGURATION_SET=your-ses-configuration-set

# Bucket-scoped credentials for staging-captures, not production-captures.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-staging-r2-access-key
R2_SECRET_ACCESS_KEY=your-staging-r2-secret-key

# Cloudflare API token for Wrangler remote bindings (not an R2 S3 key).
CLOUDFLARE_API_TOKEN=your-cloudflare-development-api-token

# Generate two independent values with: openssl rand -hex 32
AUTH_SECRET=
MEDIA_WORKER_SECRET=

# Optional, only if GitHub's unauthenticated homepage-history fetch is limited.
GITHUB_TOKEN=
