#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

step_started=$SECONDS
step() {
  printf '[setup] %s (%ss)\n' "$1" "$((SECONDS - step_started))"
  step_started=$SECONDS
}

step "checking Linux build dependencies"
packages=(
  build-essential
  curl
  dbus
  file
  grim
  hsetroot
  imagemagick
  libayatana-appindicator3-dev
  libasound2-dev
  libclang-dev
  libdbus-1-dev
  libdrm-dev
  libegl-dev
  libevdev-dev
  libexpat1-dev
  libffi-dev
  libgbm-dev
  libinih-dev
  libinput-dev
  libjson-c-dev
  libpixman-1-dev
  libpipewire-0.3-dev
  libspa-0.2-dev
  librsvg2-dev
  libssl-dev
  libsystemd-dev
  libwayland-dev
  libwebkit2gtk-4.1-dev
  libxcb1-dev
  libxdo-dev
  libxkbcommon-x11-0
  libxrandr-dev
  meson
  nasm
  ninja-build
  openbox
  picom
  pipewire
  pkg-config
  postgresql
  python3-dbus
  python3-gi
  python3-gi-cairo
  python3-xlib
  sway
  swaybg
  wayland-protocols
  wget
  wireplumber
  wl-clipboard
  x11-apps
  x11-utils
  xclip
  xdotool
  xdg-desktop-portal
  xdg-desktop-portal-gtk
  xdg-desktop-portal-wlr
  xdg-utils
  xfce4-panel
  xvfb
  xz-utils
  yasm
  zlib1g-dev
)
missing_packages=()
for package in "${packages[@]}"; do
  if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
    missing_packages+=("$package")
  fi
done
if ((${#missing_packages[@]} > 0)); then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing_packages[@]}"
fi

step "preparing private Wayland compositor fixture"
# Debian 12's Sway 1.7 lacks the fresh-configure remap fix. Keep the modern
# headless-only fixture separate; tests explicitly select its launcher PATH.
fixture_tools="$(apps/native/build_wayland_compositor_fixture.sh)"
printf '[setup] Wayland smoke launcher directory: %s\n' "$fixture_tools"

step "checking Node.js and npm"
if ! command -v npm >/dev/null 2>&1; then
  sudo apt-get update
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs npm
fi
node_major="$(node -p 'process.versions.node.split(".")[0]')"
if ((node_major != 24)); then
  npm install --global n
  n 24
  hash -r
fi
npm_major="$(npm --version | cut -d. -f1)"
if ((npm_major < 11)); then
  npm install --global npm@11
  hash -r
fi

step "installing uv and warming the pinned Python lint tool"
export PATH="$HOME/.local/bin:$PATH"
if ! command -v uv >/dev/null 2>&1 || [[ "$(uv --version | awk '{print $2}')" != 0.12.23 ]]; then
  curl --proto '=https' --tlsv1.2 -LsSf https://astral.sh/uv/0.12.23/install.sh \
    | env UV_NO_MODIFY_PATH=1 UV_INSTALL_DIR="$HOME/.local/bin" sh
  hash -r
fi
uvx --from ruff==0.16.10 ruff --version

step "installing Rust 1.94.0"
if [[ -f "$HOME/.cargo/env" ]]; then
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi
if ! command -v rustup >/dev/null 2>&1; then
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --default-toolchain none
  # shellcheck disable=SC1091
  source "$HOME/.cargo/env"
fi
rustup toolchain install 1.94.0 --profile minimal --component rustfmt --component clippy
rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy

step "installing JavaScript dependencies"
npm ci

step "fetching Rust dependencies"
cargo fetch --locked

step "complete"
printf '[setup] Node %s, npm %s, Rust %s\n' \
  "$(node --version)" \
  "$(npm --version)" \
  "$(rustc --version | awk '{print $2}')"
